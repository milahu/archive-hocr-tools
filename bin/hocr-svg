#!/usr/bin/env python3

import sys
import base64
import argparse

from hocr.parse import hocr_page_iterator
from hocr.parse import hocr_page_to_word_data
from hocr.text import hocr_page_text
from hocr.text import hocr_word_data_bbox

from PIL import Image


# debug
import json
def j(o):
    return json.dumps(o, indent=2)


def process_file(input_file, reverse):
    if not reverse:
        return process_file_hocr2svg(input_file)
    return process_file_svg2hocr(input_file)


def process_file_hocr2svg(hocrfile):
    page_count = 0

    out = sys.stdout

    page_list = list()
    page_size_list = list()
    max_page_width = 0
    sum_page_height = 0
    page_padding_right = 10
    page_padding_bottom = 10

    # get page bbox of all pages
    for raw_page in hocr_page_iterator(hocrfile):
        page = hocr_page_to_word_data(raw_page)
        # print("page", j(page))
        page_list.append(page)
        page_image_path = "001.jpg" # FIXME get image paths from sys.argv
        im = Image.open(page_image_path)
        page_size = im.size
        page_size_list.append(page_size)
        page_w, page_h = page_size
        max_page_width = max(max_page_width, page_w)
        sum_page_height += page_h

    out.write('<?xml version="1.0" encoding="UTF-8"?>\n')
    # note: inkscape requires svg version 1.1
    out.write(
        f'<svg' +
        f' version="1.1"' +
        # f' width="{max_page_width}px" height="{sum_page_height}px"' +
        f' viewBox="0 0 {max_page_width} {sum_page_height}"' +
        f' xml:space="preserve"' +
        f' xmlns="http://www.w3.org/2000/svg"' +
        f' xmlns:xlink="http://www.w3.org/1999/xlink"' +
        f'>\n'
    )
    out.write(' <style>')
    # https://stackoverflow.com/questions/31655360/svg-text-anchor-top-left
    # no, this breaks inkscape text editing...
    # out.write('  svg { dominant-baseline: hanging; }')
    out.write('  svg { dominant-baseline: mathematical; }')
    out.write(' </style>')
    page_offset_y = 0
    for page_idx, page in enumerate(page_list):
        _id = f"p{page_idx + 1}"
        out.write(f' <g id="{_id}" class="page">\n')
        page_size = page_size_list[page_idx]
        page_w, page_h = page_size
        out.write(f'  <rect class="bbox" x="0" y="{page_offset_y}" width="{page_w}" height="{page_h}" fill="none" stroke="#000" stroke-width=".26458"/>\n')
        page_image_path = "001.jpg" # FIXME get image paths from sys.argv
        with open(page_image_path, "rb") as f:
            page_image_base64 = base64.b64encode(f.read()).decode("ascii")
        # TODO set width + height?
        out.write(f'  <image opacity="0.25" x="0" y="{page_offset_y}" preserveAspectRatio="none" xlink:href="data:image/jpeg;base64,{page_image_base64}"/>\n')
        for paragraph_idx, paragraph in enumerate(page):
            _id = f"p{page_idx + 1}-p{paragraph_idx + 1}"
            out.write(f'  <g id="{_id}" class="par">\n')
            for line_idx, line in enumerate(paragraph["lines"]):
                _id = f"p{page_idx + 1}-p{paragraph_idx + 1}-l{line_idx + 1}"
                out.write(f'   <g id="{_id}" class="line">\n')
                for word_idx, word in enumerate(line["words"]):
                    _id = f"p{page_idx + 1}-p{paragraph_idx + 1}-l{line_idx + 1}-w{word_idx + 1}"
                    out.write(f'    <g id="{_id}" class="word">\n')
                    x1, y1, x2, y2 = word["bbox"]
                    w = x2 - x1
                    h = y2 - y1
                    s = h / 10 # stroke width
                    text = word["text"]
                    out.write(f'     <rect class="bbox" x="{x1}" y="{y1}" width="{w}" height="{h}" fill="none" stroke="#000" stroke-width="{s}"/>\n')
                    # text_y = y1 # this requires "dominant-baseline: hanging"
                    text_y = y2
                    text_y = y1 + (h / 2) # this requires "dominant-baseline: mathematical"
                    text_size = h # this can overflow too-narrow bboxes
                    text_size = w / len(text) * 1.5
                    out.write(f'     <text x="{x1}" y="{text_y}" fill="#000" font-size="{text_size}px" xml:space="preserve">{text}</text>\n')
                    out.write('    </g>\n') # word
                out.write('   </g>\n') # line
            out.write('  </g>\n') # par
        out.write(' </g>\n') # page
        page_offset_y += page_h
    out.write('</svg>\n')


def process_file_svg2hocr(svgfile):
    raise "TODO process_file_svg2hocr"


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='hOCR to plaintext')
    parser.add_argument(
        '-f',
        '--infile',
        help='Filename to read',
        type=str,
        required=True,
    )
    parser.add_argument(
        '-r',
        '--reverse',
        help='Reverse mode (svg2hocr)',
        default=False,
        action='store_true',
    )
    args = parser.parse_args()

    process_file(args.infile, args.reverse)
