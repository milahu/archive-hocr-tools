#!/usr/bin/env python3

# based on hocr-svg

import os
import re
import io
import sys
import base64
import argparse
import mimetypes
import zipfile
import datetime
from xml.sax.saxutils import escape
from concurrent.futures import ProcessPoolExecutor, as_completed
import importlib.resources

sys.path.append(os.path.dirname(os.path.dirname(__file__)))

from hocr.parse import hocr_page_iterator
from hocr.parse import hocr_page_to_word_data
from hocr.text import hocr_page_text
from hocr.text import hocr_word_data_bbox

from PIL import Image


hocrfile_extensions = ("hocr", "html")

# --- top-level page processor ---
def process_page(hocrfile):
    """Process a single hOCR page: compress WebP (cached) and build SVG."""
    # --- parse HOCR ---
    for page_elem in hocr_page_iterator(hocrfile):
        page = hocr_page_to_word_data(page_elem)
        break # FIXME dont assume single-page hocr files

    # --- find page image ---
    page_image_path = None
    with open(hocrfile, "rb") as f:
        if m := re.search(rb'''<div class='ocr_page'.*?title='image "([^"]+)"''', f.read()):
            page_image_path = os.path.join(os.path.dirname(hocrfile), m.group(1).decode("utf8"))
    if not page_image_path or not os.path.exists(page_image_path):
        raise ValueError(f"Missing image for {hocrfile}")

    page_base = os.path.splitext(os.path.basename(hocrfile))[0]
    cached_webp_path = f"{page_image_path}.webp"

    # --- check WebP cache ---
    if os.path.exists(cached_webp_path):
        with open(cached_webp_path, "rb") as f:
            img_data = f.read()
        im = Image.open(page_image_path)
        page_w, page_h = im.size
        im.close()
        del im
    else:
        im = Image.open(page_image_path)
        page_w, page_h = im.size
        if im.mode not in ("RGB", "L"):
            im = im.convert("RGB")
        buf = io.BytesIO()
        im.save(buf, format="WEBP", quality=1, method=6, lossless=False, optimize=True)
        img_data = buf.getvalue()
        del buf
        # save cache
        with open(cached_webp_path, "wb") as f:
            f.write(img_data)
        im.close()
        del im

    # --- build SVG ---
    svg_buf = io.StringIO()
    svg_buf.write('<?xml version="1.0" encoding="UTF-8"?>\n')
    svg_buf.write(
        f'<svg version="1.1" viewBox="0 0 {page_w} {page_h}"\n'
        ' preserveAspectRatio="xMidYMid meet" style="width:100%; height:auto"\n'
        ' xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"\n'
        '>\n'
    )
    svg_buf.write('<style>\n')
    svg_buf.write('text, tspan { dominant-baseline: mathematical; fill: transparent; }\n')
    svg_buf.write('</style>\n')
    svg_buf.write(
        f'<image x="0" y="0" width="{page_w}" height="{page_h}" '
        f'preserveAspectRatio="none" xlink:href="images/{page_base}.webp"/>\n'
    )

    for paragraph in page:
        first_line = paragraph["lines"][0]
        x1, y1, x2, y2 = first_line["bbox"]
        svg_buf.write(f'<text x="{x1}" y="{y1-1}" xml:space="preserve"> </text>\n')
        for line in paragraph["lines"]:
            x1, y1, x2, y2 = line["bbox"]
            svg_buf.write(f'<text x="{x1}" y="{y1}">\n')
            for word in line["words"]:
                x1, y1, x2, y2 = word["bbox"]
                w = x2 - x1
                h = y2 - y1
                text_y = y1 + (h / 2)
                text = escape(word["text"])
                svg_buf.write(
                    f'  <tspan x="{x1}" y="{text_y}" font-size="{h}px" '
                    f'textLength="{w}" lengthAdjust="spacingAndGlyphs">{text}</tspan>\n'
                )
            svg_buf.write('</text>\n')
    del page
    svg_buf.write('</svg>\n')
    svg_data = svg_buf.getvalue().encode("utf-8")
    del svg_buf
    svg_path = f"OEBPS/{page_base}.svg"
    img_path = f"OEBPS/images/{page_base}.webp"

    # --- return file paths & data ---
    return (svg_path, svg_data, img_path, img_data)


# --- check if path is an image ---
def is_image_path(path):
    _type = mimetypes.guess_file_type(path)[0]
    return _type and _type.startswith("image/")


# --- main processor ---
def process_files_hocr2epubfxl(infiles, output_path):
    # separate HOCR + images
    hocrfiles, imgfiles = [], []
    for f in infiles:
        ext = os.path.splitext(f)[1].lower().lstrip(".")
        if ext in hocrfile_extensions:
            hocrfiles.append(f)
        elif is_image_path(f):
            imgfiles.append(f)
        else:
            raise ValueError(f"Unsupported file extension {f!r}")
    if imgfiles and len(imgfiles) != len(hocrfiles):
        raise ValueError("Mismatch: HOCR files and images count differ")

    # --- create ZIP archive ---
    with zipfile.ZipFile(output_path, "w") as zf:
        # mimetype must be first and uncompressed
        zf.writestr("mimetype", "application/epub+zip", compress_type=zipfile.ZIP_STORED)

        # META-INF/container.xml
        zf.writestr(
            "META-INF/container.xml",
            "<?xml version='1.0'?>\n"
            "<container version='1.0'\n"
            " xmlns='urn:oasis:names:tc:opendocument:xmlns:container'>\n"
            "  <rootfiles>\n"
            "    <rootfile full-path='OEBPS/content.opf'\n"
            "              media-type='application/oebps-package+xml'/>\n"
            "  </rootfiles>\n"
            "</container>\n",
        )

        # --- prepare content.opf ---
        manifest_items, spine_items = [], []
        page_basenames = [os.path.splitext(os.path.basename(f))[0] for f in hocrfiles]
        for i, base in enumerate(page_basenames):
            manifest_items.append(f"<item id='page{i+1}' href='{base}.svg' media-type='image/svg+xml'/>")
            spine_items.append(f"<itemref idref='page{i+1}'/>")
            manifest_items.append(f"<item id='img{i+1}' href='images/{base}.webp' media-type='image/webp'/>")

        content_opf = (
            "<?xml version='1.0' encoding='utf-8'?>\n"
            "<package version='2.0'\n"
            " xmlns='http://www.idpf.org/2007/opf'\n"
            # TODO set book id
            # " unique-identifier='BookId'\n"
            ">\n"
            "  <metadata xmlns:dc='http://purl.org/dc/elements/1.1/'>\n"
            # TODO set metadata
            # "    <dc:title>Some Title</dc:title>\n"
            # "    <dc:language>en</dc:language>\n"
            # f"    <dc:identifier id='BookId'>urn:uuid:{datetime.datetime.now(datetime.UTC).timestamp()}</dc:identifier>\n"
            "    <dc:creator>hocr2epubfxl</dc:creator>\n"
            # "    <meta name='cover' content='img1'/>\n"
            "  </metadata>\n"
            "  <manifest>\n"
            "    <item id='ncx' href='toc.ncx' media-type='application/x-dtbncx+xml'/>\n"
            f"    {''.join(manifest_items)}\n"
            "  </manifest>\n"
            "  <spine toc='ncx'>\n"
            f"    {''.join(spine_items)}\n"
            "  </spine>\n"
            "</package>\n"
        )
        zf.writestr("OEBPS/content.opf", content_opf)

        # --- toc.ncx ---
        toc_ncx = [
            "<?xml version='1.0' encoding='UTF-8'?>\n"
            "<ncx xmlns='http://www.daisy.org/z3986/2005/ncx/' version='2005-1'>\n"
            "  <head>\n"
            # TODO set book id
            # "   <meta name='dtb:uid' content='BookId'/>\n"
            "  </head>\n"
            # TODO set metadata
            # "  <docTitle><text>Some Title</text></docTitle>\n"
            "  <navMap>\n"
        ]
        for i, base in enumerate(page_basenames):
            toc_ncx.append(
                f'    <navPoint id="navPoint-{i+1}" playOrder="{i+1}">'
                f'<navLabel><text>Page {i+1}</text></navLabel>'
                f'<content src="{base}.svg"/></navPoint>'
            )
        toc_ncx.append("  </navMap>\n</ncx>")
        zf.writestr("OEBPS/toc.ncx", "\n".join(toc_ncx))

        # --- process pages in parallel and stream directly to ZIP ---
        next_page = 0
        page_results = {}
        svg_path_list = []
        max_workers = os.cpu_count() # TODO expose CLI option
        with ProcessPoolExecutor(max_workers=max_workers) as executor:
            futures = {executor.submit(process_page, f): i for i, f in enumerate(hocrfiles)}

            for future in as_completed(futures):
                idx = futures[future]
                svg_path, svg_data, img_path, img_data = future.result()
                page_results[idx] = (svg_path, svg_data, img_path, img_data)

                # write pages in order as they become available
                while next_page in page_results:
                    svg_path, svg_data, img_path, img_data = page_results.pop(next_page)
                    zf.writestr(svg_path, svg_data, compress_type=zipfile.ZIP_DEFLATED)
                    zf.writestr(img_path, img_data, compress_type=zipfile.ZIP_STORED)
                    svg_path_list.append(svg_path)
                    next_page += 1

        reader_html_data = importlib.resources.read_binary("hocr", "data/svg-ebook-reader.html")
        reader_html_data = reader_html_data.replace(
            b"const svgFiles = [ /* TODO */ ];",
            (
                b"const svgFiles = [\n" +
                b"".join(map(lambda s: repr(s).encode("utf8") + b",\n", svg_path_list)) +
                b"];"
            )
        )
        zf.writestr("index.html", reader_html_data, compress_type=zipfile.ZIP_DEFLATED)

    # print(f"[+] EPUB written: {output_path}")


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='HOCR to EPUB-FXL')
    parser.add_argument(
        'infiles',
        nargs='+',
        help=' '.join([
            'Filenames to read.',
            'Either a list of hocr files:',
            '1.hocr 2.hocr 3.hocr.',
            'Or a list of hocr and image files:',
            '1.hocr 1.jpg 2.hocr 2.jpg 3.hocr 3.jpg.',
        ]),
    )
    parser.add_argument(
        '-o',
        '--output',
        help='path to output EPUB file',
        required=True,
    )
    args = parser.parse_args()

    process_files_hocr2epubfxl(args.infiles, args.output)
