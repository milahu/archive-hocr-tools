#!/usr/bin/env python3

# based on hocr-svg

import os
import re
import io
import sys
import base64
import argparse
import mimetypes
import zipfile
import datetime
from xml.sax.saxutils import escape
from concurrent.futures import ProcessPoolExecutor, as_completed

sys.path.append(os.path.dirname(os.path.dirname(__file__)))

from hocr.parse import hocr_page_iterator
from hocr.parse import hocr_page_to_word_data
from hocr.text import hocr_page_text
from hocr.text import hocr_word_data_bbox

from PIL import Image


hocrfile_extensions = ("hocr", "html")

text_file_extensions = (
    ".svg",
    ".xml",
    ".html",
    ".xhtml",
    ".css",
    ".opf",
    ".ncx",
    ".txt",
    ".md",
)


# debug
import json
def j(o):
    return json.dumps(o, indent=2)


def process_files(infiles, output_path):
    return process_files_hocr2epubfxl(infiles, output_path)


def is_image_path(path):
    _type = mimetypes.guess_file_type(path)[0]
    return _type and _type.startswith("image/")


def process_page(hocrfile):
    from PIL import Image
    import io, re, os
    from xml.sax.saxutils import escape
    from hocr.parse import hocr_page_iterator, hocr_page_to_word_data

    # --- extract page data ---
    for page_elem in hocr_page_iterator(hocrfile):
        page = hocr_page_to_word_data(page_elem)

    # --- find image ---
    page_image_path = None
    with open(hocrfile, "rb") as f:
        if m := re.search(rb'''<div class='ocr_page'.*?title='image "([^"]+)"''', f.read()):
            page_image_path = os.path.join(os.path.dirname(hocrfile), m.group(1).decode("utf8"))
    if not page_image_path:
        raise ValueError(f"Missing image for {hocrfile}")

    page_base = os.path.splitext(os.path.basename(hocrfile))[0]
    cached_webp_path = f"{page_image_path}.webp"

    # --- check cache ---
    if os.path.exists(cached_webp_path):
        with open(cached_webp_path, "rb") as f:
            img_data = f.read()
        im = Image.open(page_image_path)
        page_w, page_h = im.size
        im.close()
    else:
        # --- compress and save cache ---
        im = Image.open(page_image_path)
        page_w, page_h = im.size
        if im.mode not in ("RGB", "L"):
            im = im.convert("RGB")
        buf = io.BytesIO()
        im.save(buf, format="WEBP", quality=1, method=6, lossless=False, optimize=True)
        img_data = buf.getvalue()
        # write cache file
        with open(cached_webp_path, "wb") as f:
            f.write(img_data)
        im.close()

    # --- SVG generation ---
    svg_buf = io.StringIO()
    svg_buf.write('<?xml version="1.0" encoding="UTF-8"?>\n')
    svg_buf.write(
        f'<svg version="1.1" viewBox="0 0 {page_w} {page_h}" '
        'preserveAspectRatio="xMidYMid meet" style="width:100%; height:auto" '
        'xmlns="http://www.w3.org/2000/svg" '
        'xmlns:xlink="http://www.w3.org/1999/xlink">\n'
    )
    svg_buf.write('<style>svg { dominant-baseline: mathematical; } text,tspan{fill:transparent;}</style>\n')
    svg_buf.write(
        f'<image x="0" y="0" width="{page_w}" height="{page_h}" '
        f'preserveAspectRatio="none" xlink:href="images/{page_base}.webp"/>\n'
    )

    for paragraph in page:
        first_line = paragraph["lines"][0]
        x1, y1, x2, y2 = first_line["bbox"]
        svg_buf.write(f'<text x="{x1}" y="{y1-1}" xml:space="preserve"> </text>\n')
        for line in paragraph["lines"]:
            x1, y1, x2, y2 = line["bbox"]
            svg_buf.write(f'<text x="{x1}" y="{y1}">\n')
            for word in line["words"]:
                x1, y1, x2, y2 = word["bbox"]
                w = x2 - x1
                h = y2 - y1
                text_y = y1 + (h / 2)
                text = escape(word["text"])
                svg_buf.write(
                    f'  <tspan x="{x1}" y="{text_y}" font-size="{h}px" '
                    f'textLength="{w}" lengthAdjust="spacingAndGlyphs">{text}</tspan>\n'
                )
            svg_buf.write('</text>\n')
    svg_buf.write('</svg>\n')

    # --- return SVG + image ---
    return (
        f"OEBPS/{page_base}.svg",
        svg_buf.getvalue().encode("utf-8"),
        f"OEBPS/images/{page_base}.webp",
        img_data,
    )


def process_files_hocr2epubfxl(infiles, output_path):
    from PIL import Image, ImageFont, ImageDraw
    import fontconfig

    # --- setup font ---
    font_path = None
    for path in fontconfig.query(family='DejaVuSans', lang='en'):
        if os.path.basename(path) == "DejaVuSans.ttf":
            font_path = path
            break
    font = ImageFont.truetype(font_path, size=100)

    # --- split HOCR + images ---
    hocrfiles, imgfiles = [], []
    for filepath in infiles:
        ext = os.path.splitext(filepath)[1].lower().lstrip(".")
        if ext in hocrfile_extensions:
            hocrfiles.append(filepath)
        elif is_image_path(filepath):
            imgfiles.append(filepath)
        else:
            raise ValueError(f"unsupported file extension {ext!r} for {filepath!r}")
    if imgfiles:
        assert len(hocrfiles) == len(imgfiles)

    svg_pages = []
    image_entries = []

    # --- parallel processing of all pages ---
    with ProcessPoolExecutor(max_workers=os.cpu_count()) as executor:
        futures = {executor.submit(process_page, hocrfile): hocrfile for hocrfile in hocrfiles}
        for future in as_completed(futures):
            svg_path, svg_data, img_path, img_data = future.result()
            svg_pages.append((svg_path, svg_data))
            image_entries.append((img_path, img_data))

    # --- create EPUB archive ---
    with zipfile.ZipFile(output_path, "w") as zf:
        # mimetype must be first and uncompressed
        zf.writestr(
            "mimetype",
            "application/epub+zip",
            compress_type=zipfile.ZIP_STORED,
        )

        # META-INF/container.xml
        zf.writestr(
            "META-INF/container.xml",
            "<?xml version='1.0'?>\n"
            "<container version='1.0'\n"
            " xmlns='urn:oasis:names:tc:opendocument:xmlns:container'>\n"
            "  <rootfiles>\n"
            "    <rootfile full-path='OEBPS/content.opf'\n"
            "              media-type='application/oebps-package+xml'/>\n"
            "  </rootfiles>\n"
            "</container>\n",
        )

        # content.opf
        manifest_items = []
        spine_items = []
        for svg_path, _ in svg_pages:
            page_id = os.path.splitext(os.path.basename(svg_path))[0]
            manifest_items.append(
                f"<item id='{page_id}' href='{page_id}.svg' media-type='image/svg+xml'/>"
            )
            spine_items.append(f"<itemref idref='{page_id}'/>")

        for img_path, _ in image_entries:
            img_name = os.path.basename(img_path)
            manifest_items.append(
                f"<item id='{os.path.splitext(img_name)[0]}' href='images/{img_name}' media-type='image/webp'/>"
            )

        content_opf = (
            "<?xml version='1.0' encoding='utf-8'?>\n"
            "<package version='2.0'\n"
            " xmlns='http://www.idpf.org/2007/opf'\n"
            # TODO set book id
            # " unique-identifier='BookId'\n"
            ">\n"
            "  <metadata xmlns:dc='http://purl.org/dc/elements/1.1/'>\n"
            # TODO set metadata
            # "    <dc:title>Some Title</dc:title>\n"
            # "    <dc:language>en</dc:language>\n"
            # f"    <dc:identifier id='BookId'>urn:uuid:{datetime.datetime.now(datetime.UTC).timestamp()}</dc:identifier>\n"
            "    <dc:creator>hocr2epubfxl</dc:creator>\n"
            # "    <meta name='cover' content='img1'/>\n"
            "  </metadata>\n"
            "  <manifest>\n"
            "    <item id='ncx' href='toc.ncx' media-type='application/x-dtbncx+xml'/>\n"
            f"    {''.join(manifest_items)}\n"
            "  </manifest>\n"
            "  <spine toc='ncx'>\n"
            f"    {''.join(spine_items)}\n"
            "  </spine>\n"
            "</package>\n"
        )
        zf.writestr("OEBPS/content.opf", content_opf)

        # toc.ncx
        toc_ncx = [
            "<?xml version='1.0' encoding='UTF-8'?>\n"
            "<ncx xmlns='http://www.daisy.org/z3986/2005/ncx/' version='2005-1'>\n"
            "  <head>\n"
            # TODO set book id
            # "   <meta name='dtb:uid' content='BookId'/>\n"
            "  </head>\n"
            # TODO set metadata
            # "  <docTitle><text>Some Title</text></docTitle>\n"
            "  <navMap>\n"
        ]

        for svg_path, _ in svg_pages:
            page_id = os.path.splitext(os.path.basename(svg_path))[0]
            toc_ncx.append(
                f'    <navPoint id="navPoint-{page_id}" playOrder="{len(toc_ncx)}">'
                f'<navLabel><text>{page_id}</text></navLabel>'
                f'<content src="{page_id}.svg"/>'
                f'</navPoint>'
            )
        toc_ncx.append("  </navMap>\n</ncx>")
        zf.writestr("OEBPS/toc.ncx", "\n".join(toc_ncx))

        # SVG + images (interleaved, compress only text files)
        for i in range(max(len(svg_pages), len(image_entries))):
            for entries in (svg_pages, image_entries):
                if i < len(entries):
                    path, data = entries[i]
                    ext = os.path.splitext(path)[1].lower()
                    compress = zipfile.ZIP_DEFLATED if ext in text_file_extensions else zipfile.ZIP_STORED
                    zf.writestr(path, data, compress_type=compress)

    # print(f"[+] EPUB written: {output_path}")


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='HOCR to EPUB-FXL')
    parser.add_argument(
        'infiles',
        nargs='+',
        help=' '.join([
            'Filenames to read.',
            'Either a list of hocr files:',
            '1.hocr 2.hocr 3.hocr.',
            'Or a list of hocr and image files:',
            '1.hocr 1.jpg 2.hocr 2.jpg 3.hocr 3.jpg.',
        ]),
    )
    parser.add_argument(
        '-o',
        '--output',
        help='path to output EPUB file',
        required=True,
    )
    args = parser.parse_args()

    process_files(args.infiles, args.output)
